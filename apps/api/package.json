{
  "name": "@bancada/api",
  "version": "0.0.0",
  "private": true,
  "description": "API da Bancada (Express + PostgreSQL)",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "lint": "eslint .",
    "postbuild": "node scripts/verify-build.mjs",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.cli.ts",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.cli.ts",
    "migrate:prod": "node --env-file-if-exists=.env dist/db/migrate.cli.js"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@bancada/contracts": "^0.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  }
}
