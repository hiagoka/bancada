# Copie para apps/api/.env (ver ARCHITECTURE.md, seção 5). Valores compatíveis com o docker-compose da raiz.
DATABASE_URL=postgres://bancada:bancada@localhost:5432/bancada
TEST_DATABASE_URL=postgres://bancada:bancada@localhost:5432/bancada_test
PORT=3333
WEB_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3333
JWT_SECRET=TROQUE_ME
COOKIE_SAMESITE=lax
PAYMENT_PROVIDER=fake
# MP_ACCESS_TOKEN= e MP_WEBHOOK_SECRET= (obrigatórias com PAYMENT_PROVIDER=mercadopago)
# S3/MinIO. Em NODE_ENV=production todas as S3_* são obrigatórias (exceto S3_ENDPOINT, vazio na AWS);
# fora de produção, se omitidas, valem estes mesmos valores do MinIO local.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bancada
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/bancada
S3_FORCE_PATH_STYLE=true
# Produção (NODE_ENV=production) recusa PAYMENT_PROVIDER=fake. Para liberar de propósito
# (pagamentos simulados e /dev/payments/simulate expostos), defina:
# ALLOW_FAKE_PAYMENTS=true
# Cookie de sessão do admin (ver ARCHITECTURE.md, 8.5). Atrás de proxy/load balancer defina
# TRUST_PROXY (true, número de proxies ou lista de redes), senão o rate limit do login vê o IP do proxy.
# Prefira o número de proxies (ex.: TRUST_PROXY=1): "true" confia em qualquer X-Forwarded-For e
# permite burlar o limite de tentativas do login.
# TRUST_PROXY=false
# BCRYPT_COST=12

# Admin de DESENVOLVIMENTO (npm run admin:create -w apps/api). Apenas desenvolvimento local, nunca em produção.
ADMIN_DEV_EMAIL=admin@bancada.test
ADMIN_DEV_PASSWORD=KnnYjxXuzCk7dVUBUSHg
